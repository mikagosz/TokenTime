# macOS
.DS_Store

# Klucze i certyfikaty — .p12 zawiera klucz prywatny do podpisywania kodu
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Xcode — per-user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build
build/
DerivedData/
*.dSYM
*.dSYM.zip
*.hmap
*.ipa

# Swift Package Manager
.build/
.swiftpm/

# Installer build material (licence text, ReadMe, installer wizard screens).
# The author's working files — not part of the code and not for a public
# repository. The pattern covers future installers of other programs too.
* - instalator/

# The installer wizard's own project file and its artwork. They live in the repo root,
# so the "* - instalator/" pattern above never covered them — yet the .pkgbuilder file
# carries the absolute path of the author's home folder, and both are installer
# material, not code. Patterns anchored to the root so nothing in Assets.xcassets
# is caught by accident.
/*.pkgbuilder
/tokentimeikona.tiff
